  "editor.tokenColorCustomizations": {
    "comments": "#5f8f88",
    "textMateRules": [
      { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#5f8f88", "fontStyle": "italic" } },
      { "scope": ["keyword", "keyword.control", "storage", "storage.type", "storage.modifier"], "settings": { "foreground": "#e8604f" } },
      { "scope": ["string", "string.quoted", "punctuation.definition.string"], "settings": { "foreground": "#8fcf6f" } },
      { "scope": ["constant.numeric", "constant.language.boolean"], "settings": { "foreground": "#f8d769" } },
      { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#f2b52c" } },
      { "scope": ["variable", "variable.other", "meta.definition.variable"], "settings": { "foreground": "#e6efe9" } },
      { "scope": ["variable.parameter"], "settings": { "foreground": "#d6cbb0" } },
      { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"], "settings": { "foreground": "#9fe0d4" } },
      { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#f2b52c" } },
      { "scope": ["entity.name.tag"], "settings": { "foreground": "#e8604f" } },
      { "scope": ["keyword.operator"], "settings": { "foreground": "#d6f1e8" } },
      { "scope": ["punctuation", "meta.brace"], "settings": { "foreground": "#9fb8b2" } },
      { "scope": ["constant.language", "constant.other", "support.constant"], "settings": { "foreground": "#f8d769" } }
    ]
  }
